name: "HCRAF F3 Pathwide Independent Witness DEV Executor ONLY (v0.51.5)"

on:
  workflow_dispatch:
    inputs:
      lock_run_id:
        description: "Successful v0.51.5 MATRIX LOCK GitHub Run ID (not v0.51.4 Run ID)"
        required: true
        type: string

permissions:
  contents: read
  actions: read

jobs:
  pathwide-witness-dev:
    runs-on: ubuntu-latest
    container: ubuntu:20.04
    timeout-minutes: 355
    steps:
      - name: Initialize guaranteed executor failure diagnostics
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p episode_output/v0515_preflight
          printf 'Status: EXECUTOR_STARTED_NOT_AUTHORIZED. Verify MATRIX LOCK artifact before simulations.\n' > episode_output/v0515_preflight/START_HERE_ON_FAILURE.txt
      - name: Install pinned ndnSIM runtime and source verification dependencies
        shell: bash
        run: |
          set -euo pipefail
          export DEBIAN_FRONTEND=noninteractive
          apt-get update > /tmp/v0515_apt_update.log 2>&1
          apt-get install -y --no-install-recommends git curl ca-certificates build-essential \
            python3 python3-dev python3-setuptools python3-pip python3-pytest \
            pkg-config libboost-all-dev libssl-dev libsqlite3-dev libpcap-dev \
            libgsl-dev libprotobuf-dev protobuf-compiler libxml2-dev libxslt1-dev \
            libevent-dev graphviz doxygen time > /tmp/v0515_apt_install.log 2>&1
      - name: Checkout pinned repository with Git ancestry
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Confirm Matrix LOCK run and exact artifact exist (fail clearly if absent)
        shell: bash
        env:
          LOCK_RUN_ID: ${{ inputs.lock_run_id }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          python3 - <<'PYARTIFACT'
          import json,os,pathlib,re,urllib.error,urllib.request
          out=pathlib.Path('episode_output/v0515_preflight/lock_artifact_discovery.json')
          name='hcraf-f3-pathwide-witness-matrix-lock-v0515'
          run_id=os.environ.get('LOCK_RUN_ID','').strip()
          diag={'requested_run_id':run_id, 'expected_artifact':name,'status':'FAILED_NOT_AUTHORIZED'}
          def save(): out.write_text(json.dumps(diag,ensure_ascii=False,indent=2,sort_keys=True)+'\n')
          try:
            if not re.fullmatch(r'[0-9]+',run_id) or int(run_id)<=0:
              raise RuntimeError('LOCK_RUN_ID_INVALID: enter the successful v0.51.5 Matrix LOCK run ID')
            repo=os.environ['GITHUB_REPOSITORY']
            token=os.environ.get('GH_TOKEN','')
            if not token: raise RuntimeError('GITHUB_TOKEN_MISSING: actions:read is required')
            headers={'Authorization':'Bearer '+token,'Accept':'application/vnd.github+json',
                     'User-Agent':'HCRAF-v0515-Lock-Artifact-Guard',
                     'X-GitHub-Api-Version':'2022-11-28'}
            def get(url):
              with urllib.request.urlopen(urllib.request.Request(url,headers=headers),timeout=30) as res:
                return json.load(res)
            url='https://api.github.com/repos/'+repo+'/actions/runs/'+run_id
            run=get(url)
            diag.update(run_conclusion=run.get('conclusion'),run_status=run.get('status'),
                        workflow_path=run.get('path'),run_head_sha=run.get('head_sha'))
            if not (run.get('path') or '').endswith('/hcraf-stage1am-f3-pathwide-witness-matrix-lock-v0.51.5.yml'):
              raise RuntimeError('WRONG_RUN_ID: this run is not the v0.51.5 Matrix LOCK workflow')
            if run.get('conclusion')!='success':
              raise RuntimeError('MATRIX_LOCK_NOT_SUCCESSFUL: open Matrix LOCK logs; do not run DEV executor')
            found=[]
            for page in range(1,6):
              data=get(url+'/artifacts?per_page=100&page='+str(page))
              batch=data.get('artifacts',[])
              found.extend(batch)
              if len(batch)<100:break
            diag['available_artifact_names']=[a.get('name') for a in found]
            valid=[a for a in found if a.get('name')==name and not a.get('expired')]
            if not valid:
              raise RuntimeError('LOCK_ARTIFACT_NOT_FOUND: exact name missing or expired; run v0.51.5 Matrix LOCK with fixed workflow, verify its success and copy its Run ID')
            diag.update(status='LOCK_RUN_AND_ARTIFACT_DISCOVERED',artifact_id=valid[0].get('id'))
            save()
            print('PASS_LOCK_ARTIFACT_DISCOVERED',run_id,name)
          except Exception as err:
            diag['error']=str(err)
            save()
            print('STOP_BEFORE_SIMULATIONS:',str(err),flush=True)
            raise SystemExit(1)
          PYARTIFACT
      - name: Download matrix lock receipt from prior successful GitHub run
        uses: actions/download-artifact@v4
        with:
          name: hcraf-f3-pathwide-witness-matrix-lock-v0515
          run-id: ${{ inputs.lock_run_id }}
          github-token: ${{ secrets.GITHUB_TOKEN }}
          path: episode_output/v0515_preflight/lock_artifact
      - name: Verify authentic GitHub lock run, ancestry and immutable bytes
        shell: bash
        env:
          LOCK_RUN_ID: ${{ inputs.lock_run_id }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          mkdir -p episode_output/v0515_preflight
          cp /tmp/v0515_apt_update.log episode_output/v0515_preflight/apt_update.log
          cp /tmp/v0515_apt_install.log episode_output/v0515_preflight/apt_install.log
          git config --global --add safe.directory "$PWD"
          echo "bfbd90c638692ba241a161eaf5dcadfbc7dceae82ba4d5f236e863b2d849b28f  hcraf_stage1am_f3_pathwide_witness_dev_v0515_sources.zip" | sha256sum -c -
          echo "1b7ecd6bed08e3e2b965f5d04663acbeaf893950bdd56d2b084d12f50ead9304  hcraf_stage1am_f3_pathwide_witness_prereg_v0514_sources.zip" | sha256sum -c -
          python3 - <<'PYLINEAGE' > episode_output/v0515_preflight/lineage_check.log 2>&1
          import hashlib,json,os,pathlib,subprocess,urllib.request
          source='hcraf_stage1am_f3_pathwide_witness_dev_v0515_sources.zip'
          receipt_path=pathlib.Path('episode_output/v0515_preflight/lock_artifact/matrix_lock_receipt.json')
          receipt=json.loads(receipt_path.read_text())
          lock_id=os.environ['LOCK_RUN_ID']
          assert lock_id.isdigit() and int(lock_id)>0,'LOCK_RUN_ID_INVALID'
          assert receipt['status']=='PASS_PATHWIDE_WITNESS_MATRIX_LOCK_ONLY_NO_NDNSIM_RUN','LOCK_RECEIPT_NOT_PASS'
          assert str(receipt['github_run_id'])==lock_id,'LOCK_RECEIPT_RUN_ID_MISMATCH'
          assert receipt['source_zip_sha256']=='bfbd90c638692ba241a161eaf5dcadfbc7dceae82ba4d5f236e863b2d849b28f','LOCK_SOURCE_HASH_CHANGED'
          assert receipt['matrix_sha256']=='ebfc115dca3f04b096e184cd429ed92dd5d3adcbc9389e9f11301d712c8695b7','LOCK_MATRIX_HASH_CHANGED'
          assert receipt['protocol_sha256']=='c44f345d77d12972579a4237f7fee18504f6fbb4a906447d98d9a5c1d64e7ba1','LOCK_PROTOCOL_HASH_CHANGED'
          assert receipt['parent_prereg_commit']=='7b38f1619fa3fde91c1d58d94db4b15ad1850da0','PARENT_PREREG_CHANGED'
          assert receipt['simulations_executed']==0 and receipt['F3_ready'] is False,'LOCK_NOT_PURE_PREREG'
          req=urllib.request.Request('https://api.github.com/repos/'+os.environ['GITHUB_REPOSITORY']+'/actions/runs/'+lock_id,
              headers={'Authorization':'Bearer '+os.environ['GH_TOKEN'],'Accept':'application/vnd.github+json','User-Agent':'HCRAF-v0515-Guard'})
          with urllib.request.urlopen(req,timeout=30) as res:remote=json.load(res)
          assert remote.get('conclusion')=='success','LOCK_GITHUB_RUN_NOT_SUCCESS'
          assert remote.get('path','').endswith('/hcraf-stage1am-f3-pathwide-witness-matrix-lock-v0.51.5.yml'),'WRONG_LOCK_WORKFLOW'
          assert remote.get('head_sha')==receipt['git_commit_sha'],'LOCK_RUN_COMMIT_MISMATCH'
          def git(*args):return subprocess.check_output(['git',*args]).decode().strip()
          lock_sha=receipt['git_commit_sha'];head=git('rev-parse','HEAD')
          subprocess.check_call(['git','merge-base','--is-ancestor','7b38f1619fa3fde91c1d58d94db4b15ad1850da0',lock_sha])
          subprocess.check_call(['git','merge-base','--is-ancestor',lock_sha,head])
          assert lock_sha!='7b38f1619fa3fde91c1d58d94db4b15ad1850da0','LOCK_MUST_FOLLOW_PREREG'
          committed=subprocess.check_output(['git','show',lock_sha+':'+source])
          assert hashlib.sha256(committed).hexdigest()=='bfbd90c638692ba241a161eaf5dcadfbc7dceae82ba4d5f236e863b2d849b28f','LOCK_COMMIT_ZIP_BYTES_CHANGED'
          assert hashlib.sha256(pathlib.Path(source).read_bytes()).hexdigest()=='bfbd90c638692ba241a161eaf5dcadfbc7dceae82ba4d5f236e863b2d849b28f','CURRENT_ZIP_BYTES_CHANGED'
          print(json.dumps({'status':'PASS_GITHUB_MATRIX_LOCK_LINEAGE','lock_run_id':lock_id,
                 'lock_sha':lock_sha,'execute_sha':head},indent=2))
          PYLINEAGE
          cat episode_output/v0515_preflight/lineage_check.log
      - name: Restore prior approved base and new DEV sources without overwriting historical files
        shell: bash
        run: |
          set -euo pipefail
          echo "f21a132299e88fdee65397b7d846c3fa47bc7ee041dd6a161e7bd48651c925da  hcraf_stage1am_f3_mixed_sources.zip" | sha256sum -c -
          echo "b4fe49f0796ca6f12b2f140931e3158c6278dc5742309ea4c3f5f79c5502b8c4  hcraf_stage1s_approved_reference.zip" | sha256sum -c -
          mkdir -p artifact/stage1s episode_output
          python3 - <<'PYEXTRACT' > episode_output/v0515_preflight/source_extraction.log 2>&1
          import hashlib,json,pathlib,stat,zipfile
          def unpack(filename,prefix_dest,manifest=None,allow_existing_identical=True):
            with zipfile.ZipFile(filename) as z:
              assert z.testzip() is None,'ZIP_CRC:'+filename
              names=z.namelist();assert len(names)==len(set(names)),'DUPLICATE:'+filename
              if manifest:
                assert manifest in names,'MANIFEST_MISSING'
                m=json.loads(z.read(manifest))
                assert set(names)==set(m['files'])|{manifest},'MANIFEST_MEMBER_SET'
              else:m=None
              for n in names:
                if n.endswith('/'):continue
                p=pathlib.PurePosixPath(n)
                assert n and not n.startswith('/') and '..' not in p.parts and '\\' not in n,'UNSAFE_PATH'
                assert not stat.S_ISLNK(z.getinfo(n).external_attr>>16),'SYMLINK'
                blob=z.read(n)
                if m and n!=manifest:assert hashlib.sha256(blob).hexdigest()==m['files'][n],'BAD_SHA:'+n
                target=prefix_dest.joinpath(*p.parts)
                target.parent.mkdir(parents=True,exist_ok=True)
                if target.exists():
                  assert allow_existing_identical and target.read_bytes()==blob,'SOURCE_CONFLICT:'+n
                else:target.write_bytes(blob)
                if n.endswith('.sh'):target.chmod(0o755)
              print('EXTRACTED',filename,len(names))
          unpack('hcraf_stage1am_f3_mixed_sources.zip',pathlib.Path('.'),None)
          prev=json.loads(pathlib.Path('HCRAF_STAGE1AM_V047_SOURCE_SHA256.json').read_text())
          assert len(prev['files'])==295,'BAD_PREV_MANIFEST'
          for name,sha in prev['files'].items():
            assert hashlib.sha256(pathlib.Path(name).read_bytes()).hexdigest()==sha,'PREV_SHA_BAD:'+name
          unpack('hcraf_stage1s_approved_reference.zip',pathlib.Path('artifact'),None)
          unpack('hcraf_stage1am_f3_pathwide_witness_dev_v0515_sources.zip',pathlib.Path('.'),
             'HCRAF_F3_PATHWIDE_WITNESS_DEV_V0515_SOURCE_SHA256.json',False)
          PYEXTRACT
      - name: Validate immutable 84-run matrix, source locks and local tests
        shell: bash
        run: |
          set -euo pipefail
          root='hcraf/episode/docs/1AM/F3_PATHWIDE_WITNESS_DEV_v0.51.5'
          echo "ebfc115dca3f04b096e184cd429ed92dd5d3adcbc9389e9f11301d712c8695b7  $root/RUN_MATRIX_LOCKED_84.csv" | sha256sum -c -
          echo "c44f345d77d12972579a4237f7fee18504f6fbb4a906447d98d9a5c1d64e7ba1  $root/SCIENTIFIC_PROTOCOL_FA.md" | sha256sum -c -
          python3 "$root/generate_prereg.py" --verify "$root" > episode_output/v0515_preflight/schedules_verification.json
          PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s hcraf/episode/tests -p 'test_*.py' -q > episode_output/v0515_preflight/all_python_tests.log 2>&1
          tail -12 episode_output/v0515_preflight/all_python_tests.log
          python3 hcraf/episode/scripts/run_stage1am_f3_pathwide_witness_dev.py --preflight-only > episode_output/v0515_preflight/matrix_preflight.json
      - name: Compile separate C++ witness B and scenario
        shell: bash
        run: |
          set -euo pipefail
          bash hcraf/episode/scripts/build_stage1am_f3_pathwide_witness_dev.sh > episode_output/v0515_preflight/cpp_build.log 2>&1
          tail -30 episode_output/v0515_preflight/cpp_build.log
      - name: Run 84 new pre-registered DEV simulations (NO historical workflow rerun)
        shell: bash
        run: |
          set -euo pipefail
          python3 hcraf/episode/scripts/run_stage1am_f3_pathwide_witness_dev.py > episode_output/v0515_preflight/simulation_and_audit.log 2>&1
          tail -20 episode_output/v0515_preflight/simulation_and_audit.log
      - name: Upload evidence, diagnostics and RAW witness traces even on failure
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: hcraf-f3-pathwide-witness-dev-v0515-${{ github.run_number }}-${{ github.run_attempt }}
          path: |
            episode_output/v0515_preflight/
            episode_output/stage1am_f3_pathwide_witness_dev/
            episode_output/stage1am_f3_pathwide_witness_report/
          if-no-files-found: error
          compression-level: 6
